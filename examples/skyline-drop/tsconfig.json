{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "removeComments": false
  },
  "files": [
    "src/assets.d.ts",
    "src/types.ts",
    "src/pieces.ts",
    "src/levels.ts",
    "src/state.ts",
    "src/simulation.ts",
    "src/input.ts",
    "src/audio.ts",
    "src/diagnostics.ts",
    "src/presentation.ts",
    "src/main.ts"
  ]
}
