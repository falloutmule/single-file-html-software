{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfhs.local/schemas/sfhs.hermes-task.schema.json",
  "title": "SFHS Hermes bounded task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "role",
    "repository",
    "scope",
    "commands",
    "evidence",
    "acceptanceCriteria",
    "stopConditions",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": "sfhs.hermes-task@1" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 96 },
    "role": { "enum": ["builder", "checker"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "base", "baseCommit", "cleanRequired"],
      "properties": {
        "root": { "type": "string", "minLength": 3, "maxLength": 512 },
        "base": { "type": "string", "minLength": 1, "maxLength": 128 },
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cleanRequired": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedFiles", "forbiddenFiles"],
      "properties": {
        "allowedFiles": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "forbiddenFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cwd", "argv", "mutation"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 512 },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "mutation": { "enum": ["read-only", "generated-output"] },
          "allowedExitCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "requiredFiles"],
      "properties": {
        "directory": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
