{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfhs.dev/schemas/sfhs.godot-animation-export.schema.json",
  "title": "SFHS Godot animation export descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "godotProject", "scene", "animationPlayer", "workingFrame", "scale", "sheet", "anchor", "border", "samples", "variants", "metadataOutput", "validationOutput"],
  "properties": {
    "schema": { "const": "sfhs.godot-animation-export@1" },
    "godotProject": { "$ref": "#/$defs/relativePath" },
    "scene": { "type": "string", "pattern": "^res://[^\\r\\n]+$" },
    "animationPlayer": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$" },
    "workingFrame": { "$ref": "#/$defs/dimensions" },
    "scale": { "type": "integer", "minimum": 1, "maximum": 16 },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "groundedTolerance"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "groundedTolerance": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparentPixels"],
      "properties": {
        "transparentPixels": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "variantAlphaParity": { "type": "boolean" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "animation", "timeSeconds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "animation": { "type": "string", "minLength": 1 },
          "timeSeconds": { "type": "number", "minimum": 0 },
          "grounded": { "type": "boolean" }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parameters", "output"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "parameters": { "type": "object" },
          "output": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.png$" }] }
        }
      }
    },
    "metadataOutput": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.json$" }] },
    "validationOutput": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.json$" }] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "minLength": 1, "maxLength": 96 },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    }
  }
}
