{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfhs.dev/schemas/sfhs.evidence@1",
  "title": "SFHS evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run", "artifact", "commands", "verdict"],
  "properties": {
    "schema": { "const": "sfhs.evidence@1" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "startedAt": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "buildId"],
      "properties": {
        "path": { "type": "string", "pattern": "^dist/.+\\.html$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "buildId": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "status"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "status": { "enum": ["passed", "failed", "skipped"] }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "platform"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "width", "height", "profile", "semanticReview"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.png$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "semanticReview": { "enum": ["passed", "failed", "pending"] }
        }
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SFHS_[A-Z0-9_]+$" }
    },
    "verdict": { "enum": ["pass", "fail", "blocked"] }
  }
}
