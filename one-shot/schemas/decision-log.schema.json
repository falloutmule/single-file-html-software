{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfhs.dev/schemas/one-shot-decision-log@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "facts"],
  "properties": {
    "schema": { "const": "sfhs.one-shot-decision-log@1" },
    "status": { "enum": ["VERIFIED", "REPORTED", "INFERRED", "PROPOSED", "UNTESTED", "BLOCKED", "SUPERSEDED"] },
    "facts": {
      "type": "object", "additionalProperties": false, "required": ["decisions"],
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "status", "decision"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["VERIFIED", "REPORTED", "INFERRED", "PROPOSED", "UNTESTED", "BLOCKED", "SUPERSEDED"] },
              "decision": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
